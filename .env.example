# Copy to .env.local and fill in. Never commit real values.

# ---- Supabase ----
# Local dev: use the values printed by `npx supabase start`.
# Hosted: Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Not used yet; needed later for
# service-role/admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

