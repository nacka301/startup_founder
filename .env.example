# Copy to .env.local and fill in. Never commit real values.

# ---- Supabase ----
# Local dev: use the values printed by `npx supabase start`.
# Hosted: Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by scripts/dev-login-link.mjs
# (local dev tooling only) and later for service-role/admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Hosted auth email (Resend SMTP) — NOT app runtime vars ----
# These are configured in the Supabase DASHBOARD (Auth → SMTP Settings), not in
# .env.local. Required in production: the built-in Supabase mailer ignores our
# custom magic-link template (supabase/templates/magic_link.html), so without a
# custom SMTP provider the {{ .Token }} 6-digit code never reaches the user and
# the code-entry login fallback silently does nothing. Local dev needs none of
# this — `supabase start` renders the template and delivers to Inbucket.
#   Host:     smtp.resend.com
#   Port:     465
#   Username: resend
#   Password: <your RESEND_API_KEY>
#   Sender:   an address on a domain verified in Resend (e.g. login@yourdomain)

# ---- Claude API (analysis wizard + evidence pipeline) ----
# Server-only. Create a key at https://platform.claude.com → API keys.
ANTHROPIC_API_KEY=

# ---- Trigger.dev (analysis background job) ----
# Server-only. Trigger.dev dashboard → your project → API Keys → the environment
# secret key (e.g. tr_dev_… for local dev, tr_prod_… in production). Read by the
# app when it enqueues the run-analysis task, and by the Trigger.dev CLI/runtime.
TRIGGER_SECRET_KEY=

# ---- Web search (evidence gathering) ----
# Server-only. Tavily API key (https://tavily.com) — restricted searches over
# reddit.com + forums during evidence gathering.
SEARCH_API_KEY=

# ---- App base URL (email + share links) ----
# REQUIRED in every environment — there is no fallback. A missing value fails the
# build/startup on purpose, rather than silently emitting http://localhost:3000
# links in production. Absolute origin, no trailing slash (prod: the real domain).
# Used to build the report link in the "verdict ready" email and the public
# /r/[token] share URLs. Set it in ALL of:
#   - here / .env.local           (local dev, and for `trigger dev`)
#   - Vercel: Production, Preview AND Development. NEXT_PUBLIC_ vars are inlined
#     into the client bundle at BUILD time, so a runtime-only value is too late —
#     changing it needs a redeploy.
#   - Trigger.dev environment. The analysis job has no incoming request to derive
#     an origin from, so it builds the email link purely from this var.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Report-ready email (Resend REST API) ----
# Server-only. Used by the run-analysis Trigger.dev task to send the "your verdict
# is ready" email via https://api.resend.com. Set BOTH here (for local `trigger
# dev`) and in the Trigger.dev deployed environment. RESEND_FROM_EMAIL must be an
# address on a domain verified in Resend (e.g. "IdeaVerdict <hello@yourdomain>").
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Future services (not used yet; here for reference) ----
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
