# Copy to .env.local and fill in. Never commit real values.

# ---- Supabase ----
# Local dev: use the values printed by `npx supabase start`.
# Hosted: Supabase project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by scripts/dev-login-link.mjs
# (local dev tooling only) and later for service-role/admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Hosted auth email (Resend SMTP) — NOT app runtime vars ----
# These are configured in the Supabase DASHBOARD (Auth → SMTP Settings), not in
# .env.local. Required in production: the built-in Supabase mailer ignores our
# custom magic-link template (supabase/templates/magic_link.html), so without a
# custom SMTP provider the {{ .Token }} 6-digit code never reaches the user and
# the code-entry login fallback silently does nothing. Local dev needs none of
# this — `supabase start` renders the template and delivers to Inbucket.
#   Host:     smtp.resend.com
#   Port:     465
#   Username: resend
#   Password: <your RESEND_API_KEY>
#   Sender:   an address on a domain verified in Resend (e.g. login@yourdomain)

# ---- Claude API (analysis wizard) ----
# Server-only. Create a key at https://platform.claude.com → API keys.
ANTHROPIC_API_KEY=

# ---- Future services (not used yet; here for reference) ----
# TRIGGER_SECRET_KEY=
# TRIGGER_API_URL=
# RESEND_API_KEY=
# SEARCH_API_KEY=
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
